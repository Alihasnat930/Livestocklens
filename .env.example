# Environment Variables Template
# Copy this file to .env and fill in your actual values

NODE_ENV=development
PORT=5000

# Database Configuration - Neon Cloud Database
# Get your connection string from: https://console.neon.tech
# Format: postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon API Configuration (Required for GitHub Actions)
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID=your_neon_project_id

# JWT Secret for authentication
# Generate a secure random string for production
JWT_SECRET=your-secret-key-here

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Blockchain Configuration (Polygon Amoy Testnet)
BLOCKCHAIN_ENABLED=false
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=your-private-key-here