# Development Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# For development, you can use a local PostgreSQL database
# Example: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/livestock_lens

# JWT Secret for authentication
JWT_SECRET=livestock-health-meter-secret-key-change-in-production

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Blockchain Configuration (Polygon Amoy Testnet)
BLOCKCHAIN_ENABLED=true
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=2bce2d87bab2a7a1a279aa019c74c81cf76ff04fbba6d33e683a9f7df11d5754
CONTRACT_ADDRESS=0x3Fe4a2EDFdA338B049331bee4a66F500A2e9682a

# Admin Configuration
ADMIN_EMAIL=admin@farm.com
ADMIN_PASSWORD=password123

# Security
SESSION_SECRET=your-session-secret-here

# CORS (allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# Logging
LOG_LEVEL=info

# API Rate Limiting (requests per minute)
RATE_LIMIT=100